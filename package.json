{
  "name": "react-overflow-observer",
  "version": "2.0.0",
  "description": "A lightweight React hook that reports whether an element is overflowing its visible container and in which direction.",
  "author": "react-overflow-observer contributors",
  "license": "ISC",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "keywords": [
    "react",
    "overflow",
    "hook",
    "dom",
    "resize",
    "observer"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
